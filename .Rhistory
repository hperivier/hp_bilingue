# Créer le graphique animé (labels uniquement aux états, points 2009 en gris)
p_anim <- ggplot(data_anim,
aes(x = act_rate, y = FR, size = pop_25_54, color = dep_fam_quartile, group = geo)) +
# Points 2009 en gris comme référence (couche statique)
geom_point(data = data_anim_09 |> select(-year),
aes(x = act_rate, y = FR, size = pop_25_54),
color = "grey70", alpha = 0.2, inherit.aes = FALSE) +
# Points animés
geom_point(alpha = 0.6) +
scale_color_manual(values = c(
"#e78ac3",
"#fc8d62",
"#8da0cb",
"#66c2a5"
)) +
scale_y_continuous(limits = c(1, 2.25), expand = expansion(add = c(0,0.2))) +
scale_x_continuous(limits = c(58, 92)) +
scale_size_continuous(range = c(2, 10)) +
geom_hline(yintercept = fert_moy_09, linetype = "dashed", color = "grey40", size=0.5) +
geom_vline(xintercept = act_moy_09, linetype = "dashed", color = "grey40") +
geom_text(
aes(
x = 68,
y = 2.05,
label = paste0(" ", year)
),
inherit.aes = FALSE,
size = 6,
alpha=0.03
) +
ggplot2::annotate("text",
x = 60, y = 1.6,
label = paste0("Taux de fécondité moyen en 2009"),
hjust = -0.1, size = 3) +
ggplot2::annotate("text",
x = 78, y = 2.1,
label = paste0("Taux de participation moyen en 2009"),
vjust = -0.5, size = 3, angle = 90) +
geom_text(
aes(label = label),  # colonne avec les noms ou codes pays
size = 4,
vjust = -2,
show.legend = FALSE
) +
labs(title = "Fécondité et activité des femmes en Europe : une dynamique de convergence entre 2009 et 2023",
subtitle = "Réalisé par Hélène Périvier",
x = "Taux d'activité des femmes (25-54 ans), en %",
y = "Indice conjoncturel de fécondité",
color = "Niveau relatif de dépenses publiques vers les familles :",
caption =
"
Note: La taille des bulles correspond à la population de femmes âgées de 25 à 54 ans dans chaque pays en 2009 et en 2021.
Les quartiles de dépenses publiques ont été calculés à partir de la dépense publique consacrée aux familles en PPP,
rapportée à la population des moins de 15 ans du pays en 2009 et 2021.
Lecture: En Italie, l'indice conjoncturel de fécondité (ICF) s'élevait à 1,44 enfant par femme en 2009 contre 1,21 en 2023 ;
le taux d'activité des femmes âgées de 25 à 54 ans était de 64,3% en 2009 contre 69,9 % en 2023 ;
En Italie, le montant des dépenses publiques en direction des familles par enfant de moins de 15 ans
en PPP était en 2009 (comme en 2021) dans le deuxième quartile.
Source: Eurostat, gov_10a_exp, lfsi_emp_a, cens_21agr2, cens_11ag_r3, demo_find, prc_ppp_ind.
Autrice: Hélène Périvier"
) +
guides(size = "none") +
transition_states(year, transition_length = 2, state_length = 1) +
ease_aes('linear') +
theme(plot.caption = element_markdown(
size = 12,
lineheight = 1.2,
hjust = 0,
margin = margin(t = 20, r = 10 )),
axis.title = element_text(size = 10),
axis.text = element_text(size = 10),
legend.title = element_text(size = 10),
legend.text = element_text(size = 9))
g_ani <- animate(p_anim, nframes = 100, fps = 10, width = 800, height = 680, renderer = gifski_renderer(loop = TRUE),rewind = FALSE)
